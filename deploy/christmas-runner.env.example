# Copy to /home/SITE_USER/.config/christmas-runner.env (chmod 600) and fill in.
# Read by the systemd unit and by deploy/deploy.sh.

# Must match the "App Port" of the CloudPanel Python site.
PORT=8090

# Long random string; keeps players signed in across restarts.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Keep the database outside the code folder so deploys never touch it.
DB_PATH=/home/SITE_USER/data/runner.db

# 1 once the site has an SSL certificate (cookies only sent over HTTPS).
COOKIE_SECURE=1
